# Copy to .env and fill in. Never commit the real .env file.

# Appwrite — Project Settings -> General in your Appwrite console
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
# Server API key with databases.read/write, storage.read/write, users.read scopes
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=gruvle_leak

# AI providers — all optional. If none are set, the app runs on the
# deterministic HeuristicAIProvider (no external calls, no cost).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Transactional email (optional, used only for account/auth emails — never
# for automated customer-facing outreach in MVP)
RESEND_API_KEY=

# Local disk storage path used only when APPWRITE_API_KEY is unset (demo mode)
LOCAL_STORAGE_DIR=./local_storage

ENVIRONMENT=development
DEMO_MODE_FALLBACK=true

# Shared secret between web/ (server-side only) and this worker — must match
# WORKER_API_INTERNAL_TOKEN in web/.env.local. Never exposed to the browser.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_API_INTERNAL_TOKEN=change-me

# Origins allowed to call this API (comma-separated) — the deployed web
# app's origin(s) in production, localhost in dev.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
